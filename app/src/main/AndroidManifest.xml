<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- El PlaybackService (Media3) y sus permisos vienen del manifest de :tts. -->

    <!-- Instalar la version nueva descargada de GitHub (Android pide permiso al usuario). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Consultar y descargar la version nueva desde GitHub Releases (nada mas). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notificacion con el estado de la descarga e instalacion de la actualizacion. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- La descarga sigue si se sale de la app (servicio en primer plano mientras dura). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Pedir al usuario que exima la app del ahorro de bateria, para que el sistema no corte la
         lectura en voz alta con la pantalla apagada (dialogo directo desde Ajustes > Permisos). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".LectorVozApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.LectorVoz"
        tools:targetApi="33">

        <!-- Permite medir el arranque/jank (p.ej. para afinar el baseline profile) en builds de
             release con adb/Studio. No afecta a usuarios. API 29+. -->
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Abrir con": por tipo MIME. Solo content:// (sin file:// ni BROWSABLE: otra
                 app no puede hacernos abrir ficheros privados por ruta). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Abrir con": por extension (gestores que dan application/octet-stream). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\..*\\.epub" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\..*\\.pdf" />
            </intent-filter>

            <!-- Compartir hacia la app (uno o varios libros). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Resultado del instalador del sistema al actualizar. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".update.UpdateActionReceiver"
            android:exported="false" />
        <service
            android:name=".update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Compartir el fichero de diagnostico de lectura (solo esa carpeta privada). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget de escritorio "seguir escuchando". -->
        <receiver
            android:name=".widget.ListenWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lectorvoz" />
        </receiver>

    </application>
</manifest>
